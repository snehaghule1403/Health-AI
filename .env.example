# HealthAI — environment variables
# Copy to .env.local for local development. NEVER commit real values.

# ── Browser (bundled into the frontend; must NOT be secret) ──────────────────
# Supabase project URL and anon/public key: Supabase → Project Settings → API.
# The anon key is safe to expose; Row Level Security protects all data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Server only (Vercel → Project → Settings → Environment Variables) ────────
# Anthropic API key for AI features: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-sonnet-5-5)
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: AI calls allowed per user per hour (default 30)
# AI_CALLS_PER_HOUR=30
# Optional: the API falls back to the VITE_ values above if these are unset.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# ── Local scripts only (scripts/seed.mjs). Never put in Vercel or the frontend.
# SUPABASE_SERVICE_ROLE_KEY=
# SEED_PASSWORD=choose-a-strong-test-password
