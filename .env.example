# ─── HealthAI Prototype — Environment Variables ──────────────────────────────
# Copy this file to .env.local for local development.
# Never commit .env.local or any file containing real secrets.

# ── App ──────────────────────────────────────────────────────────────────────
VITE_APP_NAME=HealthAI
VITE_APP_VERSION=1.0.0

# ── Optional: OpenAI / LLM API (for real AI responses) ───────────────────────
# If not set, the app uses built-in demo AI responses (no API calls needed).
# VITE_OPENAI_API_KEY=sk-...

# ── Optional: Supabase (for real persistent database) ────────────────────────
# If not set, the app uses localStorage (works fine for academic demo).
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Optional: AI API URL (if using a backend proxy) ──────────────────────────
# VITE_API_URL=https://your-api.vercel.app/api

# ─────────────────────────────────────────────────────────────────────────────
# NOTE: This is an academic prototype. In the current implementation:
# - Authentication uses localStorage (no backend required)
# - AI responses are pre-programmed demo responses (no API key required)
# - All data persists in the browser via localStorage
# - The app is fully functional as a static SPA with no environment variables
# ─────────────────────────────────────────────────────────────────────────────
