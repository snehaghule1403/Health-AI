# HealthAI — environment variables
# Copy to .env.local for local development. NEVER commit real values.

# ── Browser (bundled into the frontend; must NOT be secret) ──────────────────
# Supabase project URL and anon/public key: Supabase → Project Settings → API.
# The anon key is safe to expose; Row Level Security protects all data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Public, unprotected domain used in emergency QR links (defaults to the
# production URL). Never set this to a preview or localhost URL.
# VITE_PUBLIC_SITE_URL=https://health-ai-omega-three.vercel.app

# ── Server only (Vercel → Project → Settings → Environment Variables) ────────
# Groq API key for AI features (free plan available): https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the model (default openai/gpt-oss-120b, on Groq's free plan)
# GROQ_MODEL=openai/gpt-oss-120b
# Optional: AI calls allowed per user per hour (default 30)
# AI_CALLS_PER_HOUR=30
# Optional: the API falls back to the VITE_ values above if these are unset.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# ── Local scripts only (scripts/seed.mjs). Never put in Vercel or the frontend.
# SUPABASE_SERVICE_ROLE_KEY=
# SEED_PASSWORD=choose-a-strong-test-password
